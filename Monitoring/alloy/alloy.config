// ===== LOKI OUTPUT =====
loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

// ===== DOCKER DISCOVERY =====
// يكتشف جميع الحاويات (Backend, DB, Redis)
discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
  refresh_interval = "10s"
}

// ===== LOGS SOURCE =====
loki.source.docker "docker_logs" {
  host    = "unix:///var/run/docker.sock"
  targets = discovery.docker.containers.targets
  forward_to = [loki.process.docker_processor.receiver]
}

// ===== PROCESSING & LABELS =====
loki.process "docker_processor" {
  forward_to = [loki.write.default.receiver]

  // استخراج الميتا داتا من دوكر (اسم الحاوية، الايدي، الخ)
  stage.docker {}

  // تحويل الميتا داتا إلى Labels واضحة للبحث في جرافانا
  stage.labels {
    values = {
      container = "name",
      service   = "com_docker_compose_service",
    }
  }

  // إذا كانت اللوغز بصيغة JSON (أحياناً سبرينغ بوت يرسلها كـ JSON)
  // سنحاول استخراج الـ Level منها، إذا فشل سيتجاهل الخطوة
  stage.json {
    expressions = {
      level = "level",
      msg   = "message",
    }
  }

  stage.static_labels {
    values = {
      environment = "development",
      application = "MeatShop",
    }
  }
}

// ===== PROMETHEUS (للمقاييس) =====
prometheus.scrape "backend" {
  targets = [{"__address__" = "backend:8080", "job" = "meat-shop"}]
  metrics_path = "/actuator/prometheus"
  forward_to   = [prometheus.remote_write.default.receiver]
}

prometheus.remote_write "default" {
  endpoint {
    url = "http://prometheus:9090/api/v1/write"
  }
}